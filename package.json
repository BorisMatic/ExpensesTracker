{
  "name": "troskovi-nekretnina",
  "version": "1.0.0",
  "description": "Mala Android aplikacija za praćenje troškova (struja, voda, grejanje...) za 2 stana i kuću",
  "private": true,
  "scripts": {
    "vendor": "node -e \"require('fs').mkdirSync('www/vendor',{recursive:true});require('fs').copyFileSync('node_modules/@capacitor/core/dist/capacitor.js','www/vendor/capacitor.js')\"",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "sync": "npm run vendor && npx cap sync android",
    "open": "npx cap open android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
